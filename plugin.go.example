package main

import (
	"fmt"
	"log"
	"sort"
	"strings"

	"github.com/SteamServerUI/PluginSkeleton/plugininterface"
)

func main() {

	runLogLine()

	runServerStart()

	getSettings()

}

func getSettings() {
	fmt.Println()
	fmt.Println()
	fmt.Println("Getting settins from plugin...")
	// Example 1: GET request to retrieve settings
	var settings map[string][]map[string]interface{}
	err := plugininterface.Get("/api/v2/settings", &settings)
	if err != nil {
		log.Fatalf("Failed to get settings: %v", err)
	}

	// Organize settings by group
	groupedSettings := make(map[string][]map[string]interface{})
	for _, setting := range settings["data"] {
		group := setting["group"].(string)
		groupedSettings[group] = append(groupedSettings[group], setting)
	}

	// Get sorted group names for consistent output
	var groupNames []string
	for group := range groupedSettings {
		groupNames = append(groupNames, group)
	}
	sort.Strings(groupNames)

	// Print settings in a formatted way
	fmt.Println("Settings:")
	for _, group := range groupNames {
		fmt.Printf("\n%s:\n", group)
		fmt.Println(strings.Repeat("-", len(group)+1))
		for _, setting := range groupedSettings[group] {
			fmt.Printf("Name: %s\n", setting["name"])
			fmt.Printf("  Description: %s\n", setting["description"])
			fmt.Printf("  Type: %s\n", setting["type"])
			fmt.Printf("  Value: %v\n", setting["value"])
			fmt.Printf("  Required: %v\n", setting["required"])
			if min, ok := setting["min"]; ok {
				fmt.Printf("  Min: %v\n", min)
			}
			fmt.Println()
		}
	}
}

func runServerStart() {
	fmt.Println("Starting server from plugin...")
	// Example 2: POST request to start the server
	payload := map[string]string{"action": "start"}
	var response map[string]any
	err := plugininterface.Post("/api/v2/server/start", payload, &response)
	if err != nil {
		fmt.Printf("Failed to start server: %v\n", err)
		return
	}
	fmt.Printf("Server start response: %+v\n", response)
}
func runLogLine() {

	fmt.Println("Sending a log line to the server...")
	// Example 2: POST request to log a line
	payload := map[string]string{
		"level":      "Info",
		"pluginname": "ExamplePlugin",
		"message":    "Hey Atanas!",
	}
	var response map[string]any
	err := plugininterface.Post("/api/v2/plugins/log", payload, &response)
	if err != nil {
		fmt.Printf("Failed to start server: %v\n", err)
		return
	}
	fmt.Printf("Server start response: %+v\n", response)
}
